<%- include('../partials/header', { title: 'Activités' }) %>
<h2>Activités</h2>
<% if (error) { %><div class="alert"><%= error %></div><% } %>
<form method="POST" action="/activities" class="form-grid">
  <input name="name" placeholder="Nom activité" required>
  <select name="association_id"><option value="">Sans association</option><% associations.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select>
  <select name="facility_id" required><option value="">Salle</option><% facilities.forEach(f => { %><option value="<%= f.id %>"><%= f.name %> (max <%= f.erp_capacity %>)</option><% }) %></select>
  <select name="day_of_week" required>
    <option>Lundi</option><option>Mardi</option><option>Mercredi</option><option>Jeudi</option><option>Vendredi</option><option>Samedi</option><option>Dimanche</option>
  </select>
  <input name="start_time" type="time" required>
  <input name="end_time" type="time" required>
  <input name="max_capacity" type="number" min="1" placeholder="Capacité" required>
  <input name="base_price" type="number" min="0" step="0.01" placeholder="Tarif de base" required>
  <select name="target_category">
    <option>Tous publics</option><option>U9</option><option>U11</option><option>U13</option><option>U15</option><option>U18</option><option>Senior</option><option>Master</option>
  </select>
  <select name="zone"><option value="full">Terrain complet</option><option value="A">Zone A</option><option value="B">Zone B</option></select>
  <label class="checkbox"><input type="checkbox" name="special_risk"> Sport à contrainte particulière</label>
  <button type="submit">Ajouter</button>
</form>
<table>
<thead><tr><th>Activité</th><th>Salle</th><th>Jour</th><th>Horaire</th><th>Capacité</th><th>Prix</th><th>Catégorie</th></tr></thead>
<tbody>
<% activities.forEach(a => { %>
<tr>
<td><%= a.name %></td><td><%= a.facility_name %></td><td><%= a.day_of_week %></td>
<td><%= String(a.start_time).slice(0,5) %> - <%= String(a.end_time).slice(0,5) %></td>
<td><%= a.max_capacity %></td><td><%= Number(a.base_price).toFixed(2) %> €</td><td><%= a.target_category %></td>
</tr>
<% }) %>
</tbody>
</table>
<%- include('../partials/footer') %>
